# ------------------------------------------------------------
# 1. Entraîner le classifieur CART
# ------------------------------------------------------------

classifiercart = ee.Classifier.smileCart() \
    .setOutputMode('MULTIPROBABILITY') \
    .train(
        features=training,
        classProperty='label',
        inputProperties=variables.bandNames()
    )

print("CART entraîné avec succès.")


# ------------------------------------------------------------
# 2. Appliquer CART à l'image complète
# ------------------------------------------------------------

predictioncart = variables.classify(classifiercart)

print("Bandes disponibles :", predictioncart.bandNames().getInfo())


# ------------------------------------------------------------
# 3. Extraire la probabilité de la classe FLOOD
# ------------------------------------------------------------
# IMPORTANT :
# MULTIPROBABILITY retourne un tableau contenant les probabilités
# des classes.
#
# [0] = classe 0 = non-flood
# [1] = classe 1 = flood

prob_cart = predictioncart \
    .arrayGet([1]) \
    .rename('CART_probability') \
    .clip(forme)


# ------------------------------------------------------------
# 4. Statistiques sur les probabilités CART
# ------------------------------------------------------------

prob_stats = prob_cart.reduceRegion(
    reducer=ee.Reducer.minMax()
        .combine(
            reducer2=ee.Reducer.mean(),
            sharedInputs=True
        )
        .combine(
            reducer2=ee.Reducer.stdDev(),
            sharedInputs=True
        ),
    geometry=forme,
    scale=30,
    maxPixels=1e9
).getInfo()

print("\n========================================")
print("STATISTIQUES DES PROBABILITÉS CART")
print("========================================")

print("Minimum :", prob_stats.get('CART_probability_min'))
print("Maximum :", prob_stats.get('CART_probability_max'))
print("Moyenne :", prob_stats.get('CART_probability_mean'))
print("Écart-type :", prob_stats.get('CART_probability_stdDev'))


# ------------------------------------------------------------
# 5. Calcul des percentiles
# ------------------------------------------------------------

percentiles_cart = prob_cart.reduceRegion(
    reducer=ee.Reducer.percentile(
        [25, 50, 75]
    ),
    geometry=forme,
    scale=30,
    maxPixels=1e9
).getInfo()

q1_cart = percentiles_cart.get(
    'CART_probability_p25'
)

q2_cart = percentiles_cart.get(
    'CART_probability_p50'
)

q3_cart = percentiles_cart.get(
    'CART_probability_p75'
)

print("\n========================================")
print("PERCENTILES CART")
print("========================================")

print("Q1 (25%) :", q1_cart)
print("Q2 (50%) :", q2_cart)
print("Q3 (75%) :", q3_cart)


# ------------------------------------------------------------
# 6. Vérifier les valeurs uniques de probabilité
# ------------------------------------------------------------
# Très important pour comprendre pourquoi certaines
# classes peuvent être absentes.

hist_prob = prob_cart.reduceRegion(
    reducer=ee.Reducer.frequencyHistogram(),
    geometry=forme,
    scale=30,
    maxPixels=1e9
).get('CART_probability')

hist_prob = ee.Dictionary(hist_prob).getInfo()

print("\n========================================")
print("VALEURS DE PROBABILITÉ CART")
print("========================================")

if hist_prob is not None:

    # Afficher les valeurs et leurs fréquences
    for value, count in sorted(
        hist_prob.items(),
        key=lambda x: float(x[0])
    ):
        print(
            f"Probabilité = {value} --> "
            f"{count} pixels"
        )

else:
    print("Histogramme non disponible.")


# ------------------------------------------------------------
# 7. Classification en quatre classes
# ------------------------------------------------------------
# 0 = Low
# 1 = Moderate
# 2 = High
# 3 = Very High

classified_cart = prob_cart.expression(
    "(prob <= q1) ? 0 : "
    "(prob <= q2) ? 1 : "
    "(prob <= q3) ? 2 : 3",
    {
        'prob': prob_cart,
        'q1': q1_cart,
        'q2': q2_cart,
        'q3': q3_cart
    }
).rename('susceptibility').clip(forme)


# ------------------------------------------------------------
# 8. Nombre de pixels par classe
# ------------------------------------------------------------

hist_class = classified_cart.reduceRegion(
    reducer=ee.Reducer.frequencyHistogram(),
    geometry=forme,
    scale=30,
    maxPixels=1e9
).get('susceptibility')

hist_class = ee.Dictionary(hist_class).getInfo()

print("\n========================================")
print("NOMBRE DE PIXELS PAR CLASSE")
print("========================================")

class_names = {
    '0': 'Low',
    '1': 'Moderate',
    '2': 'High',
    '3': 'Very High'
}

pixel_counts = {}

for class_id in ['0', '1', '2', '3']:

    count = hist_class.get(class_id, 0)

    pixel_counts[class_id] = count

    print(
        f"Classe {class_id} "
        f"({class_names[class_id]}) : "
        f"{count} pixels"
    )


# ------------------------------------------------------------
# 9. Nombre total de pixels
# ------------------------------------------------------------

total_pixels = sum(pixel_counts.values())

print("\nNombre total de pixels :", total_pixels)


# ------------------------------------------------------------
# 10. Pourcentage de chaque classe
# ------------------------------------------------------------

print("\n========================================")
print("POURCENTAGE PAR CLASSE")
print("========================================")

percentages = {}

for class_id in ['0', '1', '2', '3']:

    count = pixel_counts[class_id]

    if total_pixels > 0:
        percentage = (
            count / total_pixels
        ) * 100
    else:
        percentage = 0

    percentages[class_id] = percentage

    print(
        f"{class_names[class_id]} : "
        f"{percentage:.2f}%"
    )


# ------------------------------------------------------------
# 11. Calcul de la surface par classe
# ------------------------------------------------------------
# pixelArea() retourne la surface réelle du pixel en m².
# Division par 1e6 -> km².

pixel_area = (
    ee.Image.pixelArea()
    .divide(1e6)
    .rename('area_km2')
)

area_image = pixel_area.addBands(
    classified_cart
)

area_stats = area_image.reduceRegion(
    reducer=ee.Reducer.sum().group(
        groupField=1,
        groupName='class'
    ),
    geometry=forme,
    scale=30,
    maxPixels=1e9
)

groups = ee.List(
    area_stats.get('groups')
).getInfo()


# ------------------------------------------------------------
# 12. Organiser les surfaces
# ------------------------------------------------------------

areas = {
    0: 0,
    1: 0,
    2: 0,
    3: 0
}

for group in groups:

    class_id = int(group['class'])
    area = group['sum']

    areas[class_id] = area


print("\n========================================")
print("SUPERFICIE PAR CLASSE")
print("========================================")

for class_id in [0, 1, 2, 3]:

    print(
        f"{class_names[str(class_id)]} : "
