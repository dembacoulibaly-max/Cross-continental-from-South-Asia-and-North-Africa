# Fonction pour calculer les métriques
def compute_metrics(y_true, y_pred_proba, threshold=0.5):
    y_pred = (y_pred_proba >= threshold).astype(int)
    return {
        "precision": precision_score(y_true, y_pred),
        "recall": recall_score(y_true, y_pred),
        "f1": f1_score(y_true, y_pred),
        "accuracy": accuracy_score(y_true, y_pred),
        "kappa": cohen_kappa_score(y_true, y_pred),
        "roc_auc": roc_auc_score(y_true, y_pred_proba)
    }
# Créer des blocs spatiaux
coords = df[['longitude','latitude']].values
n_splits = 5
block_size_x = (coords[:,0].max() - coords[:,0].min()) / n_splits
block_size_y = (coords[:,1].max() - coords[:,1].min()) / n_splits

def assign_blocks(coords):
    blocks = []
    x_min, y_min = coords[:,0].min(), coords[:,1].min()
    for x, y in coords:
        bx = int((x - x_min) // block_size_x)
        by = int((y - y_min) // block_size_y)
        blocks.append(f"{bx}_{by}")
    return np.array(blocks)

groups = assign_blocks(coords)

